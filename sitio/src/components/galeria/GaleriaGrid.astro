---
/*
 * Galería — filtros (tipo + edición, combinados con AND) + grid masonry + lightbox.
 * Fuente: desing/docs/07-interactivity.md → "Galería — filtro + lightbox"
 *         desing/docs/08-images-assets.md → 12 IDs de Unsplash (placeholders temporales)
 * Todo por <script> plano (sin isla).
 */
import Kicker from '../Kicker.astro'

const U = 'https://images.unsplash.com/photo-'
const src = (id: string, h = 500) => `${U}${id}?w=600&h=${h}&fit=crop&auto=format`

type Item = { id: string; type: 'foto' | 'video'; edition: 1 | 2 | 3 | 4; h?: number }
const items: Item[] = [
  { id: '1534787238916-9ba6764efd4f', type: 'foto', edition: 4, h: 700 },
  { id: '1472791127703-64f8b7d5b93d', type: 'foto', edition: 4 },
  { id: '1506905925346-21bda4d32df4', type: 'foto', edition: 3, h: 380 },
  { id: '1502082553048-f009c37129b9', type: 'foto', edition: 3 },
  { id: '1542831371-29b0f74f9713', type: 'video', edition: 3 },
  { id: '1558981806-ec527fa84c39', type: 'foto', edition: 2, h: 640 },
  { id: '1551632436-cbf8dd35adfa', type: 'foto', edition: 2 },
  { id: '1536243929-ed92dc2f2c4d', type: 'foto', edition: 2, h: 380 },
  { id: '1497263375989-abf4f6e5ae77', type: 'foto', edition: 1 },
  { id: '1517649763962-0c623066013b', type: 'foto', edition: 1, h: 640 },
  { id: '1569880153113-76086ddde745', type: 'video', edition: 1 },
  { id: '1466098686939-b23d40efc33b', type: 'foto', edition: 1, h: 380 },
]

const tipos = [
  ['todo', 'Todo'],
  ['foto', 'Fotos'],
  ['video', 'Videos'],
]
const ediciones = ['todo', '1', '2', '3', '4']
---

<div class="mt-8">
  <Kicker class="mb-4">Ediciones anteriores</Kicker>

  <div class="flex flex-wrap gap-2" id="filter-type">
    {
      tipos.map(([val, label], i) => (
        <button
          data-filter-type={val}
          class:list={[
            'px-4 py-1.5 text-xs font-poster font-bold tracking-[0.16em] uppercase transition-colors',
            i === 0 ? 'bg-river text-white' : 'border border-river/30 text-slate hover:text-ink hover:border-river/60',
          ]}
        >
          {label}
        </button>
      ))
    }
  </div>

  <div class="mt-3 flex flex-wrap gap-2" id="filter-edition">
    {
      ediciones.map((val, i) => (
        <button
          data-filter-edition={val}
          class:list={[
            'px-3 py-1 text-[11px] font-poster font-bold tracking-[0.14em] uppercase transition-colors',
            i === 0 ? 'bg-river text-white' : 'border border-river/30 text-slate hover:text-ink hover:border-river/60',
          ]}
        >
          {val === 'todo' ? 'Todas' : `${val}.ª`}
        </button>
      ))
    }
  </div>
</div>

<div class="mt-6 columns-1 sm:columns-2 lg:columns-3 xl:columns-4 gap-3 space-y-3" id="gallery-grid">
  {
    items.map((it) => (
      <div
        class="relative break-inside-avoid cursor-pointer group overflow-hidden bg-cloud"
        data-type={it.type}
        data-edition={String(it.edition)}
      >
        <img
          src={src(it.id, it.h)}
          alt={`Edición ${it.edition}`}
          class="w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          loading="lazy"
        />
        {it.type === 'video' && (
          <span class="absolute inset-0 flex items-center justify-center">
            <span class="w-12 h-12 rounded-full bg-night/60 border border-foam/40 flex items-center justify-center text-foam">▶</span>
          </span>
        )}
      </div>
    ))
  }
</div>

<p class="mt-6 text-xs text-slate/60">
  Imágenes de referencia — se reemplazan por fotografía oficial de las ediciones anteriores.
</p>

<div id="lightbox" class="fixed inset-0 z-50 bg-night/95 hidden items-center justify-center p-6">
  <img id="lightbox-img" alt="" class="w-full max-h-[80vh] object-contain max-w-4xl" />
</div>

<script>
  // Se re-ejecuta en cada navegación con View Transitions (astro:page-load).
  function initGaleria() {
  let tipo = 'todo'
  let edicion = 'todo'

  function aplicar() {
    document.querySelectorAll<HTMLElement>('#gallery-grid > *').forEach((tile) => {
      const okTipo = tipo === 'todo' || tile.dataset.type === tipo
      const okEd = edicion === 'todo' || tile.dataset.edition === edicion
      tile.hidden = !(okTipo && okEd)
    })
  }

  function wireGroup(sel: string, attr: string, set: (v: string) => void) {
    const btns = document.querySelectorAll<HTMLButtonElement>(`${sel} button`)
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        btns.forEach((b) => {
          b.classList.remove('bg-river', 'text-white')
          b.classList.add('border', 'border-river/30', 'text-slate')
        })
        btn.classList.remove('border', 'border-river/30', 'text-slate')
        btn.classList.add('bg-river', 'text-white')
        set(btn.dataset[attr] as string)
        aplicar()
      })
    })
  }

  wireGroup('#filter-type', 'filterType', (v) => (tipo = v))
  wireGroup('#filter-edition', 'filterEdition', (v) => (edicion = v))

  const lightbox = document.getElementById('lightbox')
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null
  document.querySelectorAll<HTMLElement>('#gallery-grid > *').forEach((tile) => {
    tile.addEventListener('click', () => {
      const img = tile.querySelector('img')
      if (!img || !lightbox || !lightboxImg) return
      lightboxImg.src = img.src.replace('w=600', 'w=1200').replace(/h=\d+/, 'h=800')
      lightbox.classList.remove('hidden')
      lightbox.classList.add('flex')
    })
  })
  lightbox?.addEventListener('click', () => {
    lightbox.classList.add('hidden')
    lightbox.classList.remove('flex')
  })
  }

  document.addEventListener('astro:page-load', initGaleria)
</script>
