---
/*
 * Galería — grid masonry con fotos y videos reales del evento (Cloudinary) + lightbox.
 * Sin agrupar por edición: todo el contenido mezclado en un solo set.
 * Las URLs ya vienen con f_auto,q_auto (mejor formato + calidad automática sin
 * pérdida visible) — ver GaleriaGrid.astro → src().
 */
import Kicker from '../Kicker.astro'

const IMG_TX = 'f_auto,q_auto'
/** URL de grid (liviana) a partir de la URL cruda de Cloudinary. */
const src = (url: string, w = 700) => url.replace('/upload/', `/upload/${IMG_TX},w_${w}/`)
/** URL de mayor resolución para el lightbox. */
const srcFull = (url: string) => url.replace('/upload/', `/upload/${IMG_TX},w_1600/`)
/** Miniatura (primer frame) de un video de Cloudinary, como imagen jpg. */
const srcPoster = (videoUrl: string, w = 700) =>
  videoUrl.replace('/upload/', `/upload/so_0,${IMG_TX},w_${w}/`).replace(/\.[a-z0-9]+$/i, '.jpg')
/** URL de video optimizada (calidad automática). */
const srcVideo = (url: string) => url.replace('/upload/', '/upload/q_auto/')

type Item = { type: 'foto'; url: string } | { type: 'video'; url: string }

const fotos: string[] = [
