---
/*
 * Galería — grid masonry con fotos reales del evento (Cloudinary) + lightbox.
 * Sin agrupar por edición: todas las fotos mezcladas en un solo set.
 * Las URLs ya vienen con f_auto,q_auto (mejor formato + calidad automática sin
 * pérdida visible) — ver GaleriaGrid.astro → src().
 */
import Kicker from '../Kicker.astro'

const CLOUD_TX = 'f_auto,q_auto'
/** URL de grid (liviana) a partir de la URL cruda de Cloudinary. */
const src = (url: string, w = 700) => url.replace('/upload/', `/upload/${CLOUD_TX},w_${w}/`)
/** URL de mayor resolución para el lightbox. */
const srcFull = (url: string) => url.replace('/upload/', `/upload/${CLOUD_TX},w_1600/`)

const fotos: string[] = [
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535790/f432b494-351f-4d00-b12a-7464ff0d0e6c.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535786/83d32da5-1902-485a-821c-ea69c510169a.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535780/c58f8041-f5fa-40b9-9220-bb70f3806b66.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535776/dd58e298-4dd7-4739-9160-0f9e836bd1b1.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535773/da71490a-1763-4d0f-9b24-bf31579b883b.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535769/e74e6fee-036c-425f-a37b-bcb5a23bcc44.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535764/ddb21dc9-aad2-44ca-b399-6d1476c26ad8.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535761/ca936379-23a2-4347-9933-4697c1eaf7d2.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535757/57ee2a31-9d7c-461b-81b3-3de835f7a5b3.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535754/ff8b0cc6-d9d4-4a87-b24c-b76cb9601e51.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535749/fe8e55b8-177f-403b-b413-e4889993b12f.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535745/6a15e758-8503-4338-96a0-e62d17e403e7.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535741/ccb26bf0-8c0a-41e0-a4c0-da2ce12ac128.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535737/6d04bd5e-de7d-4945-81d4-28e6fa68ef71.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535733/9724ff86-e332-4d1f-9b0e-976c1b6e3ae1.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535729/5836e59c-32d2-41a9-bd19-a842ddc6115f.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535724/af1445b6-b2e0-4da2-87fa-61f10c4f2f48.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535720/39e774a4-0e40-449b-b55f-c6ef5bcba50c.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535716/0f46ea79-87a7-46c9-9db4-f8c0849c650d.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535711/0d49c36e-e919-459f-9360-83fe1d3dd386.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535706/edc77784-82b9-448f-98ef-467db7fb5c49.png',
  'https://res.cloudinary.com/lra0grpe/image/upload/v1788535700/8ccf7225-8a36-49f8-9e51-540569c14c58.png',
]
---

<div class="mt-8">
  <Kicker class="mb-4">Galería</Kicker>
</div>

<div class="mt-6 columns-1 sm:columns-2 lg:columns-3 xl:columns-4 gap-3 space-y-3" id="gallery-grid">
  {
    fotos.map((url, i) => (
      <div class="relative break-inside-avoid cursor-pointer group overflow-hidden bg-cloud">
        <img
          src={src(url)}
          data-full={srcFull(url)}
          alt={`MTB El Valle del Nacaome — foto ${i + 1}`}
          class="w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          loading="lazy"
        />
      </div>
    ))
  }
</div>

<div id="lightbox" class="fixed inset-0 z-50 bg-night/95 hidden items-center justify-center p-6">
  <img id="lightbox-img" alt="" class="w-full max-h-[80vh] object-contain max-w-4xl" />
</div>

<script>
  // Se re-ejecuta en cada navegación con View Transitions (astro:page-load).
  function initGaleria() {
    const lightbox = document.getElementById('lightbox')
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null

    document.querySelectorAll<HTMLElement>('#gallery-grid > *').forEach((tile) => {
      tile.addEventListener('click', () => {
        const img = tile.querySelector('img') as HTMLImageElement | null
        if (!img || !lightbox || !lightboxImg) return
        lightboxImg.src = img.dataset.full || img.src
        lightbox.classList.remove('hidden')
        lightbox.classList.add('flex')
      })
    })
    lightbox?.addEventListener('click', () => {
      lightbox.classList.add('hidden')
      lightbox.classList.remove('flex')
    })
  }

  document.addEventListener('astro:page-load', initGaleria)
</script>
