---
/*
 * Home §3 — Sobre la ruta. Foto editorial + timeline vertical de 3 hitos.
 * Fuente: desing/docs/06 (estructura) · 04 (layout 12-col) · 08 (sobre-ruta.jpg)
 * Copy: autoría propia (Known Gap #5 — el src/ React original no está en el repo).
 */
import Kicker from '../Kicker.astro'
import SectionGlow from '../SectionGlow.astro'

const hitos = [
  {
    n: '01',
    titulo: 'Salida — Escuela de Barra Honda',
    texto:
      'Concentración desde las 6:00 a.m. en el gimnasio de la escuela. Salida controlada a las 7:00 a.m. con acompañamiento de la Cruz Roja y la Policía de Tránsito.',
  },
  {
    n: '02',
    titulo: 'Mirador del Nacaome',
    texto:
      'Ascenso suave por caminos de lastre con vista al valle. Punto de hidratación y fotografía a mitad de recorrido.',
  },
  {
    n: '03',
    titulo: 'Parque Nacional Barra Honda',
    texto:
      'Llegada al sector de las cuevas. Frutas, música y actividades para toda la familia en la plaza de deportes.',
  },
]
---

<section class="relative overflow-hidden py-16 sm:py-20 md:py-24 bg-paper">
  <SectionGlow />
  <div class="relative max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12 items-center">
      <div class="md:col-span-5">
        <div class="relative">
          <div class="absolute -inset-3 border-2 border-river/25"></div>
          <img
            src="/assets/sobre-ruta.jpg"
            alt="Ciclistas en la ruta de Barra Honda"
            class="relative w-full aspect-[4/5] object-cover"
            loading="lazy"
          />
        </div>
      </div>

      <div class="md:col-span-7">
        <Kicker class="mb-4">Sobre la ruta</Kicker>
        <h2 class="font-poster font-black uppercase leading-none text-4xl sm:text-5xl xl:text-6xl text-ink">
          Un evento de la comunidad, para la comunidad
        </h2>
        <p class="mt-5 text-sm sm:text-base text-slate leading-relaxed max-w-2xl">
          Alrededor de 25 km de caminos rurales, lastre y tramos pavimentados. Un recorrido
          pensado para disfrutar sin prisa: se rueda en grupo, con paradas de hidratación y
          punto de asistencia mecánica.
        </p>

        <ol class="mt-8 space-y-6 border-l-2 border-river/25 pl-6">
          {
            hitos.map((h) => (
              <li class="relative">
                <span class="absolute -left-[1.9rem] top-0.5 w-3 h-3 rounded-full bg-river"></span>
                <p class="font-poster font-bold text-xs tracking-[0.2em] uppercase text-river">{h.n}</p>
                <h3 class="mt-1 text-base sm:text-lg font-semibold text-ink">{h.titulo}</h3>
                <p class="mt-1 text-sm text-slate leading-relaxed">{h.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
