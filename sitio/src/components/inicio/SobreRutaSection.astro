---
/*
 * Home §3 — Sobre la ruta. Foto editorial + timeline vertical de 3 hitos.
 * Fuente: desing/docs/06 (estructura) · 04 (layout 12-col) · 08 (sobre-ruta.jpg)
 * Copy: autoría propia (Known Gap #5 — el src/ React original no está en el repo).
 */
import Kicker from '../Kicker.astro'
import SectionGlow from '../SectionGlow.astro'

const hitos = [
  {
    titulo: 'Origen',
    texto:
      'Nacimos en 2022 como una iniciativa impulsada por vecinos de Barra Honda que buscaban crear un evento deportivo diferente, capaz de promover nuestros paisajes naturales y generar recursos para proyectos de desarrollo comunitario.',
  },
  {
    titulo: 'Organización',
    texto:
      'La recreativa es organizada por voluntarios comprometidos con Barra Honda, tanto residentes como personas que, aunque viven en diferentes partes del país, mantienen vivo su aporte al progreso de la comunidad. El respaldo de nuestros patrocinadores ha sido fundamental para consolidar este proyecto año tras año.',
  },
  {
    titulo: 'Impacto',
    texto:
      'Los fondos generados por el evento se invierten directamente en proyectos comunitarios que benefician áreas como salud, deporte, infraestructura y espacios públicos, mejorando la calidad de vida de los habitantes de Barra Honda.',
  },
]
---

<section class="relative overflow-hidden py-16 sm:py-20 md:py-24 bg-paper">
  <SectionGlow />
  <div class="relative max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12 items-center">
      <div class="md:col-span-5">
        <div class="relative">
          <div class="absolute -inset-3 border-2 border-river/25"></div>
          <img
            src="/assets/sobre-ruta.jpg"
            alt="Ciclistas en la ruta de Barra Honda"
            class="relative w-full aspect-[4/5] object-cover"
            loading="lazy"
          />
        </div>
      </div>

      <div class="md:col-span-7">
        <Kicker class="mb-4">Sobre la ruta</Kicker>
        <h2 class="font-poster font-black uppercase leading-none text-4xl sm:text-5xl xl:text-4xl text-ink">
         PEDALEANDO POR NUESTRA COMUNIDAD Y CONSTRUYENDO NUESTRO FUTURO.
        </h2>
        <p class="mt-5 text-sm sm:text-base text-slate leading-relaxed max-w-2xl">
          Una experiencia que combina deporte, naturaleza y solidaridad, donde cada kilómetro
recorrido contribuye al desarrollo de Barra Honda y al bienestar de sus habitantes.
        </p>

        <ol class="mt-8 space-y-6 border-l-2 border-river/25 pl-6">
          {
            hitos.map((h) => (
              <li class="relative">
                <span class="absolute -left-[1.9rem] top-0.5 w-3 h-3 rounded-full bg-river"></span>
                <h3 class="mt-1 text-base sm:text-lg font-semibold text-ink">{h.titulo}</h3>
                <p class="mt-1 text-sm text-slate leading-relaxed">{h.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
