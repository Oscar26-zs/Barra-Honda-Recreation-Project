---
/*
 * Home §5 — "Fin de semana completo". Acordeón en mobile, tarjetas 2-col en tablet/desktop.
 * Fuente: desing/docs/06 · 07 (acordeones) · 08 (4 fotos Unsplash — placeholders temporales)
 * Copy: autoría propia (Known Gap #5).
 */
import Kicker from '../Kicker.astro'
import SectionGlow from '../SectionGlow.astro'
import AccordionRow from '../AccordionRow.astro'

const actividades = [
  {
    titulo: 'Concierto en vivo — Plaza de Deportes',
    foto: 'https://res.cloudinary.com/dxrzwnjee/image/upload/v1789779383/0621ce4c-8971-4605-83fd-a524dd6b6a45.png',
    texto:
      'Domingo, agrupaciones de la zona en la plaza de deportes de Barra Honda. Entrada libre para toda la familia.',
  },
  {
    titulo: 'Ternerada nocturna — Plaza de Toros',
    foto: 'https://res.cloudinary.com/dxrzwnjee/image/upload/v1789779264/0869d49a-b592-4812-a725-a3ca0e49ce2f.png',
    texto:
      'Monta de toros y tradición guanacasteca en la plaza de toros del pueblo, con ventas de comida típica.',
  },
  {
    titulo: 'Tours guiados — Parque Nacional',
    foto: 'https://res.cloudinary.com/dxrzwnjee/image/upload/v1789827126/8be49293-7146-4447-9675-23abc09c805d.png',
    texto:
      'Recorridos a las cuevas del Parque Nacional Barra Honda con guías locales. Cupo limitado, se reserva el día del evento.',
  },
  {
    titulo: 'Feria de emprendedores',
    foto: 'https://res.cloudinary.com/dxrzwnjee/image/upload/v1789826963/e2fbef23-cace-4998-9ed8-bcce864161a6.png',
    texto:
      'Productoras y productores de Nicoya con artesanía, café y repostería. Domingo a partir de las 9:00 a.m.',
  },
]
---

<section class="relative overflow-hidden py-16 sm:py-20 md:py-24 bg-cloud">
  <SectionGlow />
  <div class="relative max-w-6xl mx-auto px-6 text-center">
    <Kicker class="mb-4">Fin de semana completo</Kicker>
    <h2 class="font-poster font-black uppercase leading-none text-4xl sm:text-5xl md:text-6xl text-ink">
      No solo se trata de rodar
    </h2>

    <!-- mobile: acordeón -->
    <div class="mt-8 sm:hidden text-left">
      {
        actividades.map((a, i) => (
          <AccordionRow title={a.titulo} index={String(i + 1).padStart(2, '0')} thumb={a.foto}>
            {a.texto}
          </AccordionRow>
        ))
      }
    </div>

    <!-- tablet / desktop: tarjetas 2-col compactas -->
    <div class="mt-8 hidden sm:grid grid-cols-2 gap-4 max-w-4xl mx-auto text-left">
      {
        actividades.map((a) => (
          <article class="bg-paper border border-river/20 overflow-hidden">
            <img src={a.foto} alt={a.titulo} class="w-full aspect-[16/9] object-cover" loading="lazy" />
            <div class="p-4 sm:p-5">
              <h3 class="text-base sm:text-lg font-poster font-black uppercase leading-tight text-ink">{a.titulo}</h3>
              <p class="mt-2 text-[13px] text-slate leading-relaxed">{a.texto}</p>
            </div>
          </article>
        ))
      }
    </div>
 </div>
</section>
