---
/*
 * Home §8 — "Reglamento básico". Acordeón en mobile, grid de tarjetas con borde
 * izquierdo en desktop (6 reglas).
 * Fuente: desing/docs/06 · 07 (acordeones) · 08 (set de íconos RuleIcon)
 * Copy: autoría propia (Known Gap #5).
 */
import Kicker from '../Kicker.astro'
import SectionGlow from '../SectionGlow.astro'
import AccordionRow from '../AccordionRow.astro'

const reglas = [
  { titulo: 'Cédula o identificación', texto: 'Presenta un documento de identidad al retirar el kit. Menores de edad, acompañados por una persona adulta responsable.' },
  { titulo: 'Casco obligatorio', texto: 'El uso de casco es obligatorio durante todo el recorrido. Sin casco no se permite la salida.' },
  { titulo: 'Bicicleta en buen estado', texto: 'Frenos, llantas y transmisión en condiciones. Habrá asistencia mecánica básica, pero no repuestos.' },
  { titulo: 'Comprobante de pago', texto: 'La inscripción se confirma con el comprobante de la transferencia o SINPE Móvil adjunto en el formulario.' },
  { titulo: 'Respeto a la ruta', texto: 'No se permite basura en el camino ni salirse del trazado señalizado. Cuidamos el Parque Nacional.' },
  { titulo: 'Rodar con precaución', texto: 'Es una actividad recreativa, no una competencia. Se rueda en grupo y se atienden las indicaciones del personal.' },
]

const ruleIcon: Record<number, string> = {
  0: 'M4 6h16v12H4z M8 10h4 M8 14h8',
  1: 'M4 13a8 8 0 0116 0v1H4z M9 14v3h6v-3',
  2: 'M14 6a4 4 0 01-5.3 5.3L4 16v4h4l4.7-4.7A4 4 0 0018 10l-2 2-3-3 2-2z',
  3: 'M6 3h12v18l-3-2-3 2-3-2-3 2z M9 8h6 M9 12h6',
  4: 'M12 3a9 9 0 100 18 9 9 0 000-18z M6 6l12 12',
  5: 'M12 3l9 16H3z M12 10v4 M12 17h.01',
}
---

<section class="relative overflow-hidden py-16 sm:py-20 md:py-24 bg-abyss">
  <SectionGlow tone="white" />
  <div class="relative max-w-6xl mx-auto px-6">
    <Kicker tone="white" class="mb-4">Antes de inscribirte</Kicker>
    <h2 class="font-poster font-black uppercase leading-none text-4xl sm:text-5xl md:text-6xl text-foam">
      Reglamento básico
    </h2>

    <!-- mobile: acordeón sobre tarjeta clara -->
    <div class="mt-8 sm:hidden bg-paper p-4">
      {
        reglas.map((r, i) => (
          <AccordionRow title={r.titulo} index={String(i + 1).padStart(2, '0')}>
            {r.texto}
          </AccordionRow>
        ))
      }
    </div>

    <!-- desktop: grid de tarjetas -->
    <div class="mt-8 hidden sm:grid grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
      {
        reglas.map((r, i) => (
          <div class="border-l-2 border-river/25 bg-night/40 hover:bg-dusk/70 transition-colors p-6 sm:p-7">
            <svg class="w-6 h-6 text-sky" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={ruleIcon[i] ?? ''} />
            </svg>
            <h3 class="mt-3 text-base sm:text-lg font-semibold text-foam">{r.titulo}</h3>
            <p class="mt-2 text-sm text-pale/70 leading-relaxed">{r.texto}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
